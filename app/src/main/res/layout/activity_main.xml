<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- ============ LIVE ============ -->
    <FrameLayout
        android:id="@+id/liveContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.camera.view.PreviewView
            android:id="@+id/previewView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <com.parth.spasha.OverlayView
            android:id="@+id/overlayView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Floating Ghost Glass status panel. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:layout_marginStart="14dp"
            android:layout_marginTop="14dp"
            android:layout_marginEnd="14dp"
            android:background="@drawable/bg_glass_top"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="11dp"
            android:paddingEnd="16dp"
            android:paddingBottom="11dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:text="SPASHA"
                    android:textColor="@color/on_background"
                    android:textSize="21sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="● LIVE"
                    android:textColor="@color/accent"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/hudText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:fontFamily="monospace"
                android:textColor="@color/muted"
                android:textSize="11sp"
                tools:text="CAM 01 · 21:24:00 · FPS 0 · PERSON 0 · VEHICLE 0 · TRACKS 0" />
        </LinearLayout>

        <!-- Floating controls and inspector, stacked above the bottom nav. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="14dp"
            android:layout_marginBottom="82dp"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/calPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_panel"
                android:orientation="vertical"
                android:padding="14dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="SPEED CALIBRATION — LINE A AT 35% HEIGHT, LINE B AT 65% HEIGHT. SET THE REAL DISTANCE BETWEEN THE TWO LINES ON THE GROUND."
                    android:textColor="@color/muted"
                    android:textSize="11sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/calDistanceInput"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_input"
                        android:fontFamily="monospace"
                        android:hint="DIST (m)"
                        android:importantForAutofill="no"
                        android:inputType="numberDecimal"
                        android:textColor="@color/on_background"
                        android:textColorHint="@color/muted"
                        android:textSize="12sp" />

                    <EditText
                        android:id="@+id/calLimitInput"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_input"
                        android:fontFamily="monospace"
                        android:hint="LIMIT (km/h)"
                        android:importantForAutofill="no"
                        android:inputType="numberDecimal"
                        android:text="40"
                        android:textColor="@color/on_background"
                        android:textColorHint="@color/muted"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/calApplyButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_button_red"
                        android:fontFamily="monospace"
                        android:text="SET"
                        android:textColor="@color/on_background"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/calCloseButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_button_dark"
                        android:fontFamily="monospace"
                        android:text="X"
                        android:textColor="@color/on_background"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_panel"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:id="@+id/infoText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="TAP A TRACK TO INSPECT IT."
                    android:textColor="@color/on_background"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/poiButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_button_red"
                    android:enabled="false"
                    android:fontFamily="monospace"
                    android:text="PIN AS POI"
                    android:textColor="@color/on_background"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_nav_pill"
                android:orientation="horizontal"
                android:padding="5dp">

                <Button
                    android:id="@+id/zoneButton"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_button_dark"
                    android:fontFamily="monospace"
                    android:text="ZONE"
                    android:textColor="@color/on_background"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/zoneDoneButton"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="5dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_button_dark"
                    android:enabled="false"
                    android:fontFamily="monospace"
                    android:text="DONE"
                    android:textColor="@color/on_background"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/clearZoneButton"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="5dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_button_dark"
                    android:fontFamily="monospace"
                    android:text="CLEAR"
                    android:textColor="@color/on_background"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/calButton"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="5dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_button_dark"
                    android:fontFamily="monospace"
                    android:text="CAL"
                    android:textColor="@color/on_background"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- ============ LOG ============ -->
    <LinearLayout
        android:id="@+id/logContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="18dp"
        android:paddingEnd="16dp"
        android:paddingBottom="92dp"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:text="Session log"
            android:textColor="@color/on_background"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/logStatsText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_panel"
            android:fontFamily="monospace"
            android:padding="14dp"
            android:text="SESSION"
            android:textColor="@color/on_background"
            android:textSize="12sp"
            android:textStyle="bold" />

        <ScrollView
            android:id="@+id/logScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:layout_weight="1"
            android:background="@drawable/bg_panel"
            android:padding="14dp">

            <TextView
                android:id="@+id/logText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textColor="@color/muted"
                android:textSize="12sp" />
        </ScrollView>
    </LinearLayout>

    <!-- ============ FLOATING BOTTOM NAV ============ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_gravity="bottom"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_nav_pill"
        android:orientation="horizontal"
        android:padding="5dp">

        <Button
            android:id="@+id/tabLiveButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_nav_selected"
            android:fontFamily="monospace"
            android:text="LIVE"
            android:textColor="@color/on_background"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/tabLogButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="5dp"
            android:layout_weight="1"
            android:background="@drawable/bg_nav_idle"
            android:fontFamily="monospace"
            android:text="LOG"
            android:textColor="@color/on_background"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
